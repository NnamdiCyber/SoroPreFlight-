# SoroPreFlight Environment Configuration
# Copy this file to .env and fill in your credentials.

# Network
SOROPREFLIGHT_NETWORK=testnet
SOROPREFLIGHT_RPC_URL=https://soroban-testnet.stellar.org
SOROPREFLIGHT_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Stellar
STELLAR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Server
SOROPREFLIGHT_PORT=3141
SOROPREFLIGHT_HOST=0.0.0.0

# Enterprise
SOROPREFLIGHT_WORKSPACE_ID=
SOROPREFLIGHT_AUDIT_LOG=true

# Database (enterprise tier)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/soropreflight
REDIS_URL=redis://localhost:6379
